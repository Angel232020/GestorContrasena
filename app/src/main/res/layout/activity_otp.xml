<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- ESPACIO -->
            <Space
                android:layout_width="wrap_content"
                android:layout_height="60dp"/>

            <!-- ICONO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="#F4FBFC"
                app:strokeColor="#CDE7EA"
                app:strokeWidth="1dp"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#1F7A8C"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- TITULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificación OTP"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#12343B"
                android:layout_marginTop="18dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Te enviamos un código por SMS"
                android:textSize="14sp"
                android:textColor="#6B8790"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="30dp"/>

            <!-- CARD OTP -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="30dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D7ECEF"
                app:strokeWidth="1dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- INPUT OTP -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Código OTP"
                        app:boxBackgroundColor="#F4FBFC"
                        app:boxStrokeWidth="0dp"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#4E7B83">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtOtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6"
                            android:textColor="#12343B"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- BOTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerificar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:text="Verificar código"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#1F7A8C"
                        app:cornerRadius="18dp"/>

                    <!-- INFO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="El código expira en 60 segundos"
                        android:textSize="12sp"
                        android:textColor="#8AA6AC"
                        android:layout_marginTop="18dp"
                        android:layout_gravity="center"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>